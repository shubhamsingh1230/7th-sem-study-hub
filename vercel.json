{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/(app|sb|notes)\\.([0-9a-f]{10})\\.(js|txt)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "crons": [
  {
   "path": "/api/keepalive",
   "schedule": "17 3 * * *"
  }
 ]
}